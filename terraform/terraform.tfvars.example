# AWS Configuration
aws_region     = "us-east-1"
aws_account_id = "123456789012"

# Project Configuration
project_name = "kiro-user-report-dashboard"

# S3 Bucket Name including prefix (e.g. kiro-dev/user)
s3_bucket_name = "your-bucket-name/prefix"

# Glue Configuration
glue_database_name = "kiro-user-report"

# Crawler Schedule (cron format)
# Default: Daily at 2 AM UTC
glue_crawler_schedule = "cron(0 2 * * ? *)"

# Identity Store ID for username lookup (required — from IAM Identity Center)
identity_store_id = "d-xxxxxxxxxx"

# CUR v2 Integration (optional — leave empty to skip)
# Set this to your CUR v2 S3 bucket/prefix to enable actual dollar cost tracking
# Requires: CUR v2 data export with "Include resource IDs" enabled in AWS Billing
# Example: "my-cur-bucket/cur-reports"
cur_s3_bucket_name = ""

# Tags
tags = {
  Project     = "Kiro User Report"
  Environment = "Development"
  ManagedBy   = "Terraform"
  Owner       = "YourName"
}
